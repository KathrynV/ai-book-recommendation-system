# Copy this file to .env and fill in real values locally. Never commit .env.

# Optional: enables the Claude reasoning/explanation pass in src/recommend.ts.
# Without this set, the demo falls back to rule-based recommendations and
# runs fully offline with no credentials required.
ANTHROPIC_API_KEY=your_api_key_here

# Production only (not used by this demo -- the demo reads from /data CSVs).
# In production this points at the store's real database instead of CSV files.
DATABASE_URL=your_database_url
DATABASE_API_KEY=your_api_key
